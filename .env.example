# Select a compatible, pinned CUDA image at the GPU deployment stage.
# Example format: vllm/vllm-openai:<verified-version> or ...@sha256:<digest>
CUDA_VLLM_IMAGE=
GPU_DEVICE_ID=0
MODEL_ROOT=../model/weights
DATA_ROOT=../data
RUNS_ROOT=../runs
# Paths are resolved relative to docker/ (the Compose file directory).
# Do not commit credentials. fetch_models.py uses the local HF login / HF_TOKEN.
